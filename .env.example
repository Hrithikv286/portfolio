SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/electrostore?retryWrites=true&w=majority
MONGODB_DB_NAME=electrostore

# Open Weather API (third-party API with fallback)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Django
DJANGO_SETTINGS_MODULE=electrostore.settings
